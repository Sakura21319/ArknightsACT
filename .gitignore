# Unity crash/test cache
Library.*

# Local prototype assets downloaded from PRTS. Do not redistribute through this repository.
Assets/_Game/Art/**/PRTS/

# Original game-client battle FX extracted locally from AssetBundles. Keep them out of source control.
Assets/_Game/Art/FX/OriginalClient/

# Generated prefabs reference local PRTS skeleton/atlas assets and therefore stay local as well.
Assets/_Game/Generated/PRTS/

# Deterministic local modular environment assets generated by ChernobogEnvironmentKitBuilder.
# The source-of-truth is the builder code; Build Prototype Scene regenerates this kit when absent.
Assets/_Game/Data/ChernobogKit/
Assets/_Game/Data/ChernobogKit.meta

# PrototypeRun is regenerated from PrototypeSceneBuilder and may contain local-only PRTS prefab GUIDs.
Assets/_Game/Scenes/PrototypeRun.unity
Assets/_Game/Scenes/PrototypeRun.unity.meta
